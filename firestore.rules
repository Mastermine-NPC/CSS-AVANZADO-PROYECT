rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().data.status == 'active';
    }

    function admin() {
      return activeUser() && userProfile().data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if ownUser(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'career', 'campus', 'role', 'status', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active';
      allow update: if (ownUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'career', 'campus'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status)
        || (admin()
          && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'blocked']);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'active'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || admin();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['name', 'description', 'category', 'transactionType', 'price', 'condition', 'imageUrl', 'ownerId', 'ownerName', 'status', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 500
        && request.resource.data.transactionType in ['sale', 'loan', 'exchange']
        && request.resource.data.status == 'active';
      allow update: if (activeUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['active', 'inactive'])
        || (admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'inactive']);
      allow delete: if false;
    }
  }
}
