{
  "name": "utp-marketplace",
  "version": "2.0.0",
  "private": true,
  "description": "Marketplace académico multipágina para estudiantes, construido con Bootstrap 5, Sass, ES Modules y Firebase.",
  "type": "module",
  "scripts": {
    "sass": "sass assets/scss/main.scss assets/css/style.css --source-map",
    "sass:watch": "sass --watch assets/scss/main.scss assets/css/style.css --source-map",
    "sass:build": "sass assets/scss/main.scss assets/css/style.min.css --style=compressed --no-source-map",
    "serve": "http-server . -p 3000 -c-1",
    "dev": "concurrently \"npm run sass:watch\" \"npm run serve\"",
    "build": "npm run sass && npm run sass:build",
    "check:js": "node scripts/check-js.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "npm run build && npm run check:js && npm run check:links"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mastermine-NPC/CSS-AVANZADO-PROYECT.git"
  },
  "license": "ISC",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "firebase-tools": "^15.23.0",
    "http-server": "^14.1.1",
    "sass": "^1.69.7"
  }
}
