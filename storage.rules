rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function user() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)); }
    function isActiveUser() { return isSignedIn() && user().data.status == 'active'; }
    function isAdmin() { return isActiveUser() && user().data.role == 'admin'; }
    function validImage() { return request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }

    match /users/{uid}/profile/{fileName} {
      allow read: if true;
      allow create, update: if isActiveUser() && request.auth.uid == uid && validImage();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }
    match /products/{uid}/{productId}/{fileName} {
      allow read: if (firestore.exists(/databases/(default)/documents/products/$(productId))
        && firestore.get(/databases/(default)/documents/products/$(productId)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/products/$(productId)).data.moderationStatus == 'approved')
        || (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if isActiveUser() && request.auth.uid == uid && validImage();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }
  }
}

